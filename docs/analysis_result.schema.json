{
  "$defs": {
    "AnalysisMetadata": {
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "title": "Strategy",
          "type": "string"
        },
        "strategy_description": {
          "default": "",
          "title": "Strategy Description",
          "type": "string"
        },
        "strategy_options": {
          "additionalProperties": true,
          "title": "Strategy Options",
          "type": "object"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "package_version": {
          "title": "Package Version",
          "type": "string"
        },
        "provider": {
          "additionalProperties": true,
          "title": "Provider",
          "type": "object"
        },
        "provider_is_mock": {
          "title": "Provider Is Mock",
          "type": "boolean"
        },
        "prompt_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Prompt Versions",
          "type": "object"
        },
        "run_seed": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Seed"
        },
        "case_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Case Id"
        },
        "operational": {
          "$ref": "#/$defs/OperationalStats"
        },
        "reference_verification": {
          "anyOf": [
            {
              "$ref": "#/$defs/ReferenceVerificationReport"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "conflict_candidates": {
          "items": {
            "$ref": "#/$defs/CandidatePairRecord"
          },
          "title": "Conflict Candidates",
          "type": "array"
        },
        "graph_decisions": {
          "items": {
            "$ref": "#/$defs/GraphDecision"
          },
          "title": "Graph Decisions",
          "type": "array"
        },
        "llm_calls": {
          "items": {
            "$ref": "#/$defs/LLMCallSummary"
          },
          "title": "Llm Calls",
          "type": "array"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "strategy",
        "created_at",
        "package_version",
        "provider_is_mock"
      ],
      "title": "AnalysisMetadata",
      "type": "object"
    },
    "CandidatePairRecord": {
      "additionalProperties": false,
      "properties": {
        "requirement_ids": {
          "items": {
            "type": "string"
          },
          "maxItems": 2,
          "minItems": 2,
          "title": "Requirement Ids",
          "type": "array"
        },
        "selectors": {
          "items": {
            "type": "string"
          },
          "title": "Selectors",
          "type": "array"
        },
        "graph_derived": {
          "default": false,
          "title": "Graph Derived",
          "type": "boolean"
        },
        "analyzed": {
          "default": false,
          "title": "Analyzed",
          "type": "boolean"
        }
      },
      "required": [
        "requirement_ids",
        "selectors"
      ],
      "title": "CandidatePairRecord",
      "type": "object"
    },
    "ConflictCoverage": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "completed",
            "partial",
            "disabled",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "potential_conflicts_found",
            "no_conflicts_detected_in_available_text",
            "not_examined"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "candidate_pairs": {
          "default": 0,
          "title": "Candidate Pairs",
          "type": "integer"
        },
        "pairs_analyzed": {
          "default": 0,
          "title": "Pairs Analyzed",
          "type": "integer"
        },
        "pairs_failed": {
          "default": 0,
          "title": "Pairs Failed",
          "type": "integer"
        },
        "total_possible_pairs": {
          "default": 0,
          "title": "Total Possible Pairs",
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "status",
        "outcome"
      ],
      "title": "ConflictCoverage",
      "type": "object"
    },
    "ConflictType": {
      "enum": [
        "contradictory_obligation",
        "numeric_incompatibility",
        "timing_incompatibility",
        "process_incompatibility",
        "potential_precedence_conflict",
        "applicability_conflict",
        "other_or_uncertain"
      ],
      "title": "ConflictType",
      "type": "string"
    },
    "Coverage": {
      "additionalProperties": false,
      "properties": {
        "documents": {
          "items": {
            "$ref": "#/$defs/DocumentCoverage"
          },
          "title": "Documents",
          "type": "array"
        },
        "referenced_documents": {
          "items": {
            "$ref": "#/$defs/ReferencedDocumentCoverage"
          },
          "title": "Referenced Documents",
          "type": "array"
        },
        "unresolved_identifiers": {
          "items": {
            "type": "string"
          },
          "title": "Unresolved Identifiers",
          "type": "array"
        },
        "conflict_analysis": {
          "$ref": "#/$defs/ConflictCoverage"
        },
        "limitations": {
          "items": {
            "$ref": "#/$defs/CoverageLimitation"
          },
          "title": "Limitations",
          "type": "array"
        }
      },
      "required": [
        "conflict_analysis"
      ],
      "title": "Coverage",
      "type": "object"
    },
    "CoverageLimitation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "unavailable_referenced_document",
            "unparsed_section",
            "unresolved_identifier",
            "truncated_input",
            "unsupported_input",
            "llm_call_failed",
            "conflict_analysis_incomplete",
            "segmentation_uncertain",
            "oversized_segment"
          ],
          "title": "Kind",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "document_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Document Id"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Id"
        },
        "chunk_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Chunk Id"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "title": "CoverageLimitation",
      "type": "object"
    },
    "DocumentCoverage": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "status": {
          "enum": [
            "analyzed",
            "partially_analyzed",
            "unsupported",
            "failed"
          ],
          "title": "Status",
          "type": "string"
        },
        "chars_total": {
          "title": "Chars Total",
          "type": "integer"
        },
        "chars_processed": {
          "title": "Chars Processed",
          "type": "integer"
        },
        "segments_total": {
          "title": "Segments Total",
          "type": "integer"
        },
        "segments_processed": {
          "title": "Segments Processed",
          "type": "integer"
        },
        "notes": {
          "items": {
            "type": "string"
          },
          "title": "Notes",
          "type": "array"
        }
      },
      "required": [
        "document_id",
        "status",
        "chars_total",
        "chars_processed",
        "segments_total",
        "segments_processed"
      ],
      "title": "DocumentCoverage",
      "type": "object"
    },
    "DocumentType": {
      "enum": [
        "standard",
        "technical_specification",
        "engineering_drawing",
        "procedure",
        "quality_manual",
        "customer_specification",
        "form",
        "unknown"
      ],
      "title": "DocumentType",
      "type": "string"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "A quotation from the source text that supports a claim.\n\n``verified`` is True only when ``quoted_text`` was found in the extracted\nsource text. Model explanations are never stored here.",
      "properties": {
        "source_document_id": {
          "title": "Source Document Id",
          "type": "string"
        },
        "requirement_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Requirement Id"
        },
        "quoted_text": {
          "minLength": 1,
          "title": "Quoted Text",
          "type": "string"
        },
        "source_location": {
          "anyOf": [
            {
              "$ref": "#/$defs/SourceLocation"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "start_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Start Offset"
        },
        "end_offset": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "End Offset"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Verified"
        },
        "verification": {
          "default": "not_checked",
          "enum": [
            "exact",
            "whitespace_normalized",
            "not_found",
            "not_checked"
          ],
          "title": "Verification",
          "type": "string"
        },
        "repaired": {
          "default": false,
          "description": "True when a verification step replaced an unlocatable model quote with source text.",
          "title": "Repaired",
          "type": "boolean"
        }
      },
      "required": [
        "source_document_id",
        "quoted_text"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "GraphDecision": {
      "additionalProperties": false,
      "description": "A processing decision that used the relationship graph (graph_assisted only).",
      "properties": {
        "decision_type": {
          "enum": [
            "alias_resolved",
            "audit_candidate",
            "conflict_candidate_added",
            "context_retrieved",
            "rule_flagged_conflict"
          ],
          "title": "Decision Type",
          "type": "string"
        },
        "detail": {
          "title": "Detail",
          "type": "string"
        },
        "node_ids": {
          "items": {
            "type": "string"
          },
          "title": "Node Ids",
          "type": "array"
        }
      },
      "required": [
        "decision_type",
        "detail"
      ],
      "title": "GraphDecision",
      "type": "object"
    },
    "InputDocument": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "canonical_identifier": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Canonical Identifier"
        },
        "identifier_source": {
          "enum": [
            "header",
            "filename",
            "manifest"
          ],
          "title": "Identifier Source",
          "type": "string"
        },
        "filename": {
          "title": "Filename",
          "type": "string"
        },
        "title": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Title"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        },
        "format": {
          "enum": [
            "txt",
            "pdf",
            "json"
          ],
          "title": "Format",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        },
        "char_count": {
          "title": "Char Count",
          "type": "integer"
        },
        "pages": {
          "items": {
            "$ref": "#/$defs/PageSpan"
          },
          "title": "Pages",
          "type": "array"
        },
        "parse_status": {
          "enum": [
            "ok",
            "partial",
            "unsupported",
            "failed"
          ],
          "title": "Parse Status",
          "type": "string"
        },
        "warnings": {
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "text": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Extracted text. Verbatim relative to the parser's output; offsets refer to it.",
          "title": "Text"
        }
      },
      "required": [
        "document_id",
        "canonical_identifier",
        "identifier_source",
        "filename",
        "format",
        "sha256",
        "char_count",
        "parse_status"
      ],
      "title": "InputDocument",
      "type": "object"
    },
    "LLMCallSummary": {
      "additionalProperties": false,
      "properties": {
        "call_id": {
          "title": "Call Id",
          "type": "string"
        },
        "stage": {
          "title": "Stage",
          "type": "string"
        },
        "task": {
          "title": "Task",
          "type": "string"
        },
        "prompt_version": {
          "title": "Prompt Version",
          "type": "string"
        },
        "success": {
          "title": "Success",
          "type": "boolean"
        },
        "attempts": {
          "title": "Attempts",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "input_chars": {
          "title": "Input Chars",
          "type": "integer"
        },
        "output_chars": {
          "title": "Output Chars",
          "type": "integer"
        },
        "latency_seconds": {
          "title": "Latency Seconds",
          "type": "number"
        },
        "graph_informed": {
          "default": false,
          "title": "Graph Informed",
          "type": "boolean"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "call_id",
        "stage",
        "task",
        "prompt_version",
        "success",
        "attempts",
        "input_chars",
        "output_chars",
        "latency_seconds"
      ],
      "title": "LLMCallSummary",
      "type": "object"
    },
    "MentionStatus": {
      "description": "Where a reference came from. Lets experiments separate stages.",
      "enum": [
        "found_initially",
        "added_during_verification",
        "added_by_graph_audit"
      ],
      "title": "MentionStatus",
      "type": "string"
    },
    "OperationalStats": {
      "additionalProperties": false,
      "description": "Cost and effort measures. ``None`` means not measurable, never zero-filled.",
      "properties": {
        "total_seconds": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Seconds"
        },
        "stage_seconds": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Stage Seconds",
          "type": "object"
        },
        "llm_calls": {
          "default": 0,
          "title": "Llm Calls",
          "type": "integer"
        },
        "llm_failed_calls": {
          "default": 0,
          "title": "Llm Failed Calls",
          "type": "integer"
        },
        "json_validation_failures": {
          "default": 0,
          "title": "Json Validation Failures",
          "type": "integer"
        },
        "retries": {
          "default": 0,
          "title": "Retries",
          "type": "integer"
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Input Tokens"
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Output Tokens"
        },
        "input_chars": {
          "default": 0,
          "title": "Input Chars",
          "type": "integer"
        },
        "output_chars": {
          "default": 0,
          "title": "Output Chars",
          "type": "integer"
        },
        "estimated_cost_usd": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Estimated Cost Usd"
        },
        "graph_informed_calls": {
          "default": 0,
          "title": "Graph Informed Calls",
          "type": "integer"
        }
      },
      "title": "OperationalStats",
      "type": "object"
    },
    "PageSpan": {
      "additionalProperties": false,
      "properties": {
        "page_number": {
          "minimum": 1,
          "title": "Page Number",
          "type": "integer"
        },
        "start_offset": {
          "minimum": 0,
          "title": "Start Offset",
          "type": "integer"
        },
        "end_offset": {
          "minimum": 0,
          "title": "End Offset",
          "type": "integer"
        }
      },
      "required": [
        "page_number",
        "start_offset",
        "end_offset"
      ],
      "title": "PageSpan",
      "type": "object"
    },
    "PotentialConflict": {
      "additionalProperties": false,
      "properties": {
        "conflict_id": {
          "title": "Conflict Id",
          "type": "string"
        },
        "related_requirement_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Related Requirement Ids",
          "type": "array"
        },
        "related_document_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Document Ids",
          "type": "array"
        },
        "related_relationship_ids": {
          "items": {
            "type": "string"
          },
          "title": "Related Relationship Ids",
          "type": "array"
        },
        "conflict_type": {
          "$ref": "#/$defs/ConflictType"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "review_status": {
          "const": "requires_human_review",
          "default": "requires_human_review",
          "title": "Review Status",
          "type": "string"
        },
        "reason_for_review": {
          "title": "Reason For Review",
          "type": "string"
        },
        "assessment": {
          "default": "apparent_incompatibility",
          "enum": [
            "apparent_incompatibility",
            "ambiguous"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "detection_methods": {
          "items": {
            "type": "string"
          },
          "title": "Detection Methods",
          "type": "array"
        },
        "evidence_valid": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evidence Valid"
        },
        "metadata": {
          "additionalProperties": true,
          "title": "Metadata",
          "type": "object"
        }
      },
      "required": [
        "conflict_id",
        "related_requirement_ids",
        "conflict_type",
        "description",
        "reason_for_review"
      ],
      "title": "PotentialConflict",
      "type": "object"
    },
    "ReferenceMention": {
      "additionalProperties": false,
      "description": "One occurrence of a document reference inside one requirement.",
      "properties": {
        "mention_id": {
          "title": "Mention Id",
          "type": "string"
        },
        "document_id": {
          "title": "Document Id",
          "type": "string"
        },
        "raw_identifier": {
          "title": "Raw Identifier",
          "type": "string"
        },
        "relation": {
          "$ref": "#/$defs/ReferenceRelation",
          "default": "references"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "status": {
          "$ref": "#/$defs/MentionStatus"
        },
        "resolution": {
          "$ref": "#/$defs/ResolutionMethod"
        },
        "verified": {
          "description": "Passed the verification stage. False when no verification ran.",
          "title": "Verified",
          "type": "boolean"
        }
      },
      "required": [
        "mention_id",
        "document_id",
        "raw_identifier",
        "evidence",
        "status",
        "resolution",
        "verified"
      ],
      "title": "ReferenceMention",
      "type": "object"
    },
    "ReferenceRelation": {
      "description": "How a requirement relates to a document it mentions.\n\nEvery mention is a reference. The other values record an *explicit*\nqualifier stated in the source text; they are never inferred from\nrevision numbers or dates.",
      "enum": [
        "references",
        "excludes",
        "supersedes",
        "depends_on",
        "takes_precedence_over"
      ],
      "title": "ReferenceRelation",
      "type": "string"
    },
    "ReferenceVerificationReport": {
      "additionalProperties": false,
      "description": "Initial predictions are kept next to the verified ones for analysis.",
      "properties": {
        "enabled": {
          "title": "Enabled",
          "type": "boolean"
        },
        "attempts_used": {
          "default": 0,
          "title": "Attempts Used",
          "type": "integer"
        },
        "initial_mentions": {
          "items": {
            "$ref": "#/$defs/ReferenceMention"
          },
          "title": "Initial Mentions",
          "type": "array"
        },
