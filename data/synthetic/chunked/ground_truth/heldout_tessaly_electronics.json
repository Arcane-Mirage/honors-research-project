      "chapter": "TSA 2.3",
      "requirement_text": "Software release notes shall reference TSA-SW-500 Rev 4 for all releases issued\nafter 1 July 2026.",
      "start_offset": 962,
      "end_offset": 1060,
      "references": [
        {
          "canonical_identifier": "TSA-SW-500",
