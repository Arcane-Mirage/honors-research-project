      "source_document_id": "DOC-TSA-CSR-300-REV-2",
      "chapter": "TSA 3.1",
      "requirement_text": "Printed circuit board assemblies shall be cleaned according to the TSA-MP-210\nspecification, and ionic contamination shall not exceed 1.0 µg/cm² NaCl equivalent.",
      "start_offset": 1090,
      "end_offset": 1251,
      "references": [
        {
          "canonical_identifier": "TSA-MP-210",
          "revision": null,
          "mention_text": "TSA-MP-210",
          "relation": "references",
          "resolution": "identifier"
        }
      ],
      "tags": [
