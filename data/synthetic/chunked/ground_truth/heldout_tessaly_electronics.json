      "chapter": "TSA 2.2",
      "requirement_text": "Software for electronic control units shall be developed according to TSA-SW-500\nrev.3.",
      "start_offset": 865,
      "end_offset": 952,
      "references": [
        {
          "canonical_identifier": "TSA-SW-500",
