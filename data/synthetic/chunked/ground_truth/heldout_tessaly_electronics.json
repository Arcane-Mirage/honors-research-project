      "gold_id": "TSA-CSR-300#TSA 2.1",
      "source_document_id": "DOC-TSA-CSR-300-REV-2",
      "chapter": "TSA 2.1",
      "requirement_text": "The supplier shall submit the design failure mode and effects analysis to Tessaly\nAutomotive at each design review, and the analysis shall follow the methodology described in\nTessaly procedure TSA-QP-031; where the analysis identifies a severity rating of 9 or 10,\nthe supplier shall additionally document the mitigation actions according to TSA-QP-032 and\nshall report the results of all associated validation tests using the template in\nTSA-QF-031A.",
      "start_offset": 404,
      "end_offset": 855,
      "references": [
        {
          "canonical_identifier": "TSA-QP-031",
          "revision": null,
          "mention_text": "TSA-QP-031",
          "relation": "references",
