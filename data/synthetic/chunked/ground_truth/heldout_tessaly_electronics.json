      "source_document_id": "DOC-TSA-CSR-300-REV-2",
      "chapter": "TSA 3.3",
      "requirement_text": "Coated assemblies shall be inspected under ultraviolet light as described in\nTSA-MP-215, and assemblies with coating voids larger than 0.5 mm shall be rejected.",
      "start_offset": 1384,
      "end_offset": 1544,
      "references": [
