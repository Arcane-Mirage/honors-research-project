      "source_document_id": "DOC-TSA-CSR-300-REV-2",
      "chapter": "TSA 3.2",
      "requirement_text": "Conformal coating shall be applied in accordance with Specification TSA MP 215 and\ncured for at least 30 minutes.",
      "start_offset": 1261,
      "end_offset": 1374,
      "references": [
        {
          "canonical_identifier": "TSA-MP-215",
