# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# The pipeline only reads the variable named by `llm.api_key_env` in the config.

# Commercial OpenAI-compatible API
OPENAI_API_KEY=

# Local OpenAI-compatible server (llama.cpp `llama-server`, vLLM, Ollama).
# Most local servers accept any non-empty key or none at all.
LOCAL_LLM_API_KEY=not-needed
